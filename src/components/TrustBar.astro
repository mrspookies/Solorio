---
import { trustBadges } from '../data/site';
---

<section aria-label="Credentials" class="border-b border-steel-800 bg-steel-950">
  <div class="container-page">
    <dl class="grid grid-cols-2 gap-px bg-steel-800 md:grid-cols-4">
      {
        trustBadges.map((badge) => (
          <div class="group bg-steel-950 px-4 py-5 transition-colors hover:bg-steel-900 md:px-5">
            <dt class="flex items-center gap-2 font-mono text-[0.625rem] tracking-[0.18em] text-gold-400 uppercase">
              <svg
                aria-hidden="true"
                viewBox="0 0 24 24"
                class="h-3.5 w-3.5 shrink-0 text-red-300"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M20 6 9 17l-5-5" />
              </svg>
              {badge.label}
            </dt>
            <dd class="mt-1.5 pl-[1.375rem] text-sm leading-snug text-steel-300">
              {badge.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>