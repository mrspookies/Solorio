---
import { projectCategories, projects } from '../data/site';

type Props = {
  active: 'all' | 'framing' | 'finish' | 'remodel' | 'repair';
};

const { active } = Astro.props;

/** Per-category tile counts, derived so the numbers can never drift from the data. */
const counts = projectCategories.map((category) => ({
  ...category,
  count:
    category.id === 'all'
      ? projects.length
      : projects.filter((project) => project.category === category.id).length,
}));
---

<div id="project-filter" class="relative -mx-5 overflow-x-auto px-5 sm:mx-0 sm:px-0">
  <div
    class="flex min-w-max snap-x items-center gap-2 sm:min-w-0 sm:flex-wrap"
    role="group"
    aria-label="Filter projects by category"
  >
    {
      counts.map((category) => {
        const isActive = category.id === active;
        return (
          <button
            type="button"
            data-filter={category.id}
            aria-pressed={isActive}
            class:list={[
              'snap-start border px-4 py-2.5 font-mono text-xs tracking-[0.14em] uppercase transition-colors duration-200',
              isActive
                ? 'border-red-500 bg-red-500 text-steel-50'
                : 'border-steel-700 text-steel-300 hover:border-gold-500 hover:text-gold-300',
            ]}
          >
            {category.label}
            <span
              class:list={[
                'ml-1.5 text-[0.625rem]',
                isActive ? 'text-steel-50/70' : 'text-steel-500',
              ]}
            >
              ({category.count})
            </span>
          </button>
        );
      })
    }
  </div>
</div>