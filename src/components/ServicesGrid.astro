---
import { services } from '../data/site';
import PhotoSlot from './PhotoSlot.astro';
---

<section id="craft" aria-labelledby="craft-heading" class="section section-band surface-brushed">
  <div class="container-page">
    <div class="max-w-2xl">
      <p class="eyebrow">What I Build</p>
      <h2 id="craft-heading" class="heading-lg mt-5 text-steel-50 uppercase">
        The Craft
      </h2>
      <p class="lede mt-5">
        Four kinds of work, all under one roof. Most of my jobs are a mix &mdash;
        you don&rsquo;t need to know which category yours falls into.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <article class="card-plate hover-sweep hover-lift group flex flex-col">
            <div class="relative overflow-hidden">
              <PhotoSlot
                src={service.photo}
                label={service.photoLabel}
                alt={`${service.title} — project photography pending`}
                aspect="4/3"
                class="transition-[filter] duration-300 group-hover:brightness-125"
              />
              <span
                class="absolute top-3 left-3 border border-steel-600 bg-steel-950/85 px-2 py-1 font-mono text-[0.5625rem] tracking-[0.18em] text-steel-300 uppercase backdrop-blur"
              >
                {service.index}
              </span>
            </div>

            <div class="flex flex-1 flex-col p-5">
              <div class="flex items-center gap-3">
                <span class="font-mono text-sm tracking-[0.1em] text-gold-500 transition-colors duration-300 group-hover:text-red-300">
                  {service.index}
                </span>
                <span class="rule-hairline flex-1" aria-hidden="true" />
              </div>

              <h3 class="mt-4 font-display text-3xl leading-none text-steel-50">
                {service.title}
              </h3>

              <p class="mt-3 text-sm leading-relaxed text-steel-300">{service.blurb}</p>

              <ul class="mt-5 space-y-2">
                {service.includes.map((item) => (
                  <li class="flex gap-2.5 text-sm text-steel-400">
                    <span class="mt-[0.45rem] h-1 w-1 shrink-0 bg-gold-500" aria-hidden="true" />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <a href="#quote" class="btn-link mt-auto pt-6 self-start">
                Discuss this work
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>