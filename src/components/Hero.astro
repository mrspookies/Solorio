---
import { site, craftStats } from '../data/site';
---

<section id="top" class="surface-brutal relative isolate overflow-hidden">
  <!-- Layered depth: wood glow, hazard band, ghost letterforms. CSS only. -->
  <div
    class="pointer-events-none absolute inset-0 -z-10"
    aria-hidden="true"
  >
    <div
      class="absolute top-[-15%] left-1/2 h-[46rem] w-[46rem] -translate-x-1/2 rounded-full bg-[radial-gradient(circle,rgba(179,153,93,0.20),transparent_68%)]"
    >
    </div>
    <div
      class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-steel-950 to-transparent"
    >
    </div>
    <!-- Diagonal hazard band -->
    <div
      class="absolute top-[22%] -right-[10%] h-16 w-[55%] -rotate-[8deg] opacity-[0.07]"
      style="background-image: repeating-linear-gradient(-45deg, #aa0000 0 14px, transparent 14px 34px);"
    >
    </div>
    <!-- Ghost letterform -->
    <span
      class="absolute -bottom-6 left-1/2 -translate-x-1/2 font-display text-[26rem] leading-none text-transparent select-none"
      style="-webkit-text-stroke: 1px rgba(255,255,255,0.028);"
      aria-hidden="true">S</span
    >
  </div>

  <div class="container-page flex min-h-[clamp(34rem,88svh,52rem)] flex-col justify-center py-20">
    <p class="eyebrow">Master Carpenter &middot; General Contractor</p>

    <h1
      class="mt-6 max-w-[13ch] text-display-xl font-display text-steel-50 uppercase"
    >
      Built Right.<br />
      Built to <span class="mark-gold text-gold-400">Last.</span>
    </h1>

    <p class="lede mt-7 max-w-[46ch]">
      Thirty-plus years of hands-on framing, finish carpentry, and structural repair.
      One crew, my own hands, and a job I&rsquo;m willing to sign my name to. Licensed,
      insured, and still answering the phone.
    </p>

    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
      <a href="#quote" class="btn-cta w-full sm:w-auto">
        Get a Free Estimate
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
      </a>

      <a href={site.phoneHref} class="btn-ghost w-full sm:w-auto">
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path
            d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"
          ></path>
        </svg>
        {site.phoneDisplay}
      </a>
    </div>

    <dl class="mt-14 grid max-w-2xl grid-cols-1 gap-px border border-steel-800 bg-steel-800 sm:grid-cols-3">
      {
        craftStats.map((stat) => (
          <div class="bg-steel-900 px-5 py-5">
            <dt class="order-2 mt-1 font-mono text-[0.625rem] tracking-[0.16em] text-steel-400 uppercase">
              {stat.label}
            </dt>
            <dd class="order-1 font-display text-4xl leading-none text-gold-400">
              {stat.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>