---
import PhotoSlot from './PhotoSlot.astro';

type Side = {
  src: string | null;
  label: string;
};

type Props = {
  id: string;
  before: Side;
  after: Side;
  aspect?: string;
};

const { id, before, after, aspect = '16/10' } = Astro.props;

/**
 * Before/after compare slider.
 *
 * The BEFORE layer is clipped with `clip-path: inset(0 X% 0 0)`; the AFTER layer
 * sits underneath at full width. A transparent native <input type="range"> overlays
 * the whole surface, which provides keyboard + AT support for free, while a
 * pointer-driven handler keeps drag and click-to-jump feeling native.
 */
---

<div
  id={id}
  class="ba-slider group relative w-full overflow-hidden select-none"
  data-ba-slider
  style={`aspect-ratio:${aspect};`}
  role="group"
  aria-label={`Before and after comparison: ${before.label} versus ${after.label}`}
>
  <!-- AFTER — base layer -->
  <div class="absolute inset-0">
    <PhotoSlot
      src={after.src}
      label={after.label}
      alt={`After — ${after.label}`}
      aspect={aspect}
      class="h-full w-full"
      loading="lazy"
    />
  </div>

  <!-- BEFORE — clipped reveal layer -->
  <div
    class="ba-before absolute inset-0"
    data-ba-before
    style="clip-path: inset(0 50% 0 0);"
  >
    <PhotoSlot
      src={before.src}
      label={before.label}
      alt={`Before — ${before.label}`}
      aspect={aspect}
      class="h-full w-full"
      loading="lazy"
    />
  </div>

  <!-- Corner tags -->
  <span
    class="pointer-events-none absolute top-3 left-3 border border-steel-600 bg-steel-950/85 px-2 py-1 font-mono text-[0.5625rem] tracking-[0.18em] text-steel-300 uppercase backdrop-blur"
    >Before</span
  >
  <span
    class="pointer-events-none absolute top-3 right-3 border border-gold-600 bg-steel-950/85 px-2 py-1 font-mono text-[0.5625rem] tracking-[0.18em] text-gold-300 uppercase backdrop-blur"
    >After</span
  >

  <!-- Divider + grip -->
  <div
    class="ba-divider pointer-events-none absolute inset-y-0 left-1/2 w-0.5 -translate-x-1/2 bg-red-500"
    data-ba-divider
    aria-hidden="true"
  >
    <span
      class="absolute top-1/2 left-1/2 flex h-10 w-10 -translate-x-1/2 -translate-y-1/2 items-center justify-center rounded-full border-2 border-red-500 bg-steel-950 shadow-lg transition-transform duration-200 group-hover:scale-110"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-4 w-4 text-red-400"
        fill="none"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="m9 7-5 5 5 5M15 7l5 5-5 5"></path>
      </svg>
    </span>
  </div>

  <!-- Accessible control. Transparent, full-bleed, natively keyboard operable. -->
  <input
    type="range"
    min="0"
    max="100"
    step="0.5"
    value="50"
    aria-label="Reveal the after photo"
    data-ba-range
    class="absolute inset-0 z-10 h-full w-full cursor-ew-resize appearance-none bg-transparent opacity-0 focus-visible:opacity-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-red-500"
  />
</div>

<style>
  /* Only the interactive surface swallows gestures — the rest of the page scrolls. */
  .ba-slider {
    touch-action: none;
  }
</style>

<script>
  function initBeforeAfter(): void {
    document.querySelectorAll<HTMLElement>('[data-ba-slider]').forEach((slider) => {
      if (slider.dataset['baReady'] === 'true') return;
      slider.dataset['baReady'] = 'true';

      const range = slider.querySelector<HTMLInputElement>('[data-ba-range]');
      const before = slider.querySelector<HTMLElement>('[data-ba-before]');
      const divider = slider.querySelector<HTMLElement>('[data-ba-divider]');
      if (!range || !before || !divider) return;

      const apply = (value: number): void => {
        const pct = Math.min(Math.max(value, 0), 100);
        before.style.clipPath = `inset(0 ${100 - pct}% 0 0)`;
        divider.style.left = `${pct}%`;
      };

      // Range input drives the reveal (keyboard, and pointer where supported).
      range.addEventListener('input', () => apply(Number(range.value)));

      // Pointer drag anywhere on the surface.
      let dragging = false;

      const fromEvent = (event: PointerEvent): void => {
        const rect = slider.getBoundingClientRect();
        if (rect.width === 0) return;
        const pct = ((event.clientX - rect.left) / rect.width) * 100;
        range.value = String(Math.min(Math.max(pct, 0), 100));
        apply(Number(range.value));
      };

      slider.addEventListener('pointerdown', (event) => {
        dragging = true;
        slider.setPointerCapture(event.pointerId);
        fromEvent(event);
      });

      slider.addEventListener('pointermove', (event) => {
        if (dragging) fromEvent(event);
      });

      const endDrag = (event: PointerEvent): void => {
        dragging = false;
        if (slider.hasPointerCapture(event.pointerId)) {
          slider.releasePointerCapture(event.pointerId);
        }
      };

      slider.addEventListener('pointerup', endDrag);
      slider.addEventListener('pointercancel', endDrag);

      apply(Number(range.value));
    });
  }

  initBeforeAfter();
  document.addEventListener('astro:after-swap', initBeforeAfter);
</script>